{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist/types-web",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
    // M2.2 used to need `"types": ["node"]` here because `@termhub/shared`'s
    // package.json points `types`/`main` straight at its *source*, so this
    // project's program ended up type-checking protocol.ts's whole
    // implementation, including its old `Buffer`-based framing, not just
    // the types this project actually needs. The framing was rewritten
    // (see protocol.ts's file header) to use only `Uint8Array`/`DataView`/
    // `TextEncoder`/`TextDecoder`, which exist identically without Node's
    // globals, so this project no longer needs `@types/node` at all.
  },
  "include": [
    "src/renderer/src/**/*",
    "src/preload/index.d.ts",
    "src/preload/bridge.ts",
    "src/main/ipc-contract.ts"
  ]
}
